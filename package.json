{
  "name": "haghighi-platform",
  "version": "1.0.0",
  "description": "Complete platform with NestJS backend, React admin panel and user frontend",
  "scripts": {
    "dev": "docker-compose -f docker-compose.dev.yml up --build",
    "dev:simple": "docker-compose up --build",
    "start": "docker-compose up",
    "start:prod": "./deploy.sh",
    "stop": "docker-compose down",
    "stop:dev": "docker-compose -f docker-compose.dev.yml down",
    "build": "docker-compose build",
    "build:prod": "docker-compose -f docker-compose.prod.yml build",
    "logs": "docker-compose logs -f",
    "logs:dev": "docker-compose -f docker-compose.dev.yml logs -f",
    "setup:nginx": "./setup-nginx.sh",
    "test": "curl -I http://localhost && curl -I http://localhost/admin && curl -I http://localhost/api"
  },
  "keywords": [
    "nestjs",
    "react",
    "postgresql",
    "docker"
  ],
  "author": "Arash Haghighi",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.12.2",
    "csv-parser": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.1"
  }
}
