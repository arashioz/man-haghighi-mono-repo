# Dovecot SQL configuration
driver = mysql
connect = host=127.0.0.1 dbname=mailserver user=mailuser password=CHANGE_THIS_PASSWORD
default_pass_scheme = SHA512-CRYPT
password_query = SELECT email as user, password FROM virtual_users WHERE email='%u';
user_query = SELECT email as user, 5000 as uid, 5000 as gid, '/var/mail/vhosts/%d/%n' as home FROM virtual_users WHERE email='%u';

