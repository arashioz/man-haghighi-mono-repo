# Server Environment Configuration
# Replace 185.231.112.84 with your actual server IP

# Database
POSTGRES_DB=haghighi_db
POSTGRES_USER=haghighi_user
POSTGRES_PASSWORD=ChangeThisPassword123!

# JWT - CHANGE THIS!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Backend
PORT=3000
NODE_ENV=production
MAX_FILE_SIZE=10737418240
UPLOAD_PATH=/app/uploads

# Database URL
DATABASE_URL=postgresql://haghighi_user:ChangeThisPassword123!@postgres:5432/haghighi_db?schema=public

# API URL - Replace with your server IP
REACT_APP_API_URL=http://185.231.112.84:3000/api

