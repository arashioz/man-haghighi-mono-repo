# Server Environment Configuration
# Replace 185.231.112.84 with your actual server IP

# Database
POSTGRES_DB=haghighi_db
POSTGRES_USER=haghighi_user
POSTGRES_PASSWORD=ChangeThisPassword123!

# JWT - CHANGE THIS!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Backend
PORT=3000
NODE_ENV=production
MAX_FILE_SIZE=10737418240
UPLOAD_PATH=/app/uploads

# CORS Configuration (REQUIRED for production)
# Comma-separated list of allowed origins (no wildcards allowed)
# Example: http://185.231.112.84:8080,http://185.231.112.84:8081,http://185.231.112.84:8082
CORS_ORIGINS=http://185.231.112.84:8080,http://185.231.112.84:8081,http://185.231.112.84:8082

# Server Configuration (for dynamic URLs)
SERVER_IP=185.231.112.84
EXTERNAL_PORT=8080

# API Base URL for file uploads (including port)
API_BASE_URL=http://185.231.112.84:8080

# Database URL
DATABASE_URL=postgresql://haghighi_user:ChangeThisPassword123!@postgres:5432/haghighi_db?schema=public

# Prisma Accelerate (optional - for query caching)
# Get your connection string from https://www.prisma.io/accelerate
# PRISMA_ACCELERATE_URL=prisma://accelerate.prisma-data.net/?api_key=your_api_key

# API URL for React apps - Replace with your server IP
REACT_APP_API_URL=http://185.231.112.84:8080/api

