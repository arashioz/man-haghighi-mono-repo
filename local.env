# Local Development Environment

# Database
POSTGRES_DB=haghighi_db
POSTGRES_USER=haghighi_user
POSTGRES_PASSWORD=SecurePassword123

# JWT
JWT_SECRET=local-dev-secret-key
JWT_EXPIRES_IN=7d

# Backend
PORT=3000
NODE_ENV=development
MAX_FILE_SIZE=10737418240
UPLOAD_PATH=/app/uploads

# Server Configuration (for dynamic URLs)
SERVER_IP=localhost
EXTERNAL_PORT=3000

# API Base URL for file uploads
API_BASE_URL=http://localhost:3000

# Database URL
DATABASE_URL=postgresql://haghighi_user:SecurePassword123@postgres:5432/haghighi_db?schema=public

# Prisma Accelerate (optional - for query caching)
# Get your connection string from https://www.prisma.io/accelerate
# PRISMA_ACCELERATE_URL=prisma://accelerate.prisma-data.net/?api_key=your_api_key

# API URL (for frontend/admin)
REACT_APP_API_URL=http://localhost:3000/api

# SMS Service (IranPayamak)
# Get your credentials from https://iranpayamak.com
IRANPAYAMAK_API_KEY=your-api-key-here
IRANPAYAMAK_LINE_NUMBER=50002178584000
IRANPAYAMAK_PATTERN_CODE=SJ3FgPrE0C
